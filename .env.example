# Copy to .env and fill in. Never commit .env.
# Paste the raw value only: no quotes, no surrounding < > (a value like <abc123> is rejected).
# SEC requires a descriptive User-Agent with contact info, e.g. "TradingAgentPro yourname@example.com"
SEC_USER_AGENT=
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# https://newsapi.org (aggregator only, never sufficient proof on its own)
NEWSAPI_KEY=
# Free keys (phase P4.1, `python main.py collect`): https://data.bls.gov/registrationEngine/ ,
# https://apps.bea.gov/API/signup/ , https://www.eia.gov/opendata/register.php
BLS_API_KEY=
BEA_API_KEY=
EIA_API_KEY=
